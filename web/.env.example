# Application Runtime Configuration
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# Deployment & Release Identification (Passed by CI/CD or Kubernetes)
APP_VERSION=1.0.0
APP_ENV=development
APP_RELEASE_ID=local-dev
APP_COMMIT_SHA=local
APP_BUILD_TIME=
APP_INSTANCE_ID=local

# DevOps Testing & Chaos Simulation Flags (Disabled by default)
SIMULATE_UNREADY=false
SIMULATE_UNHEALTHY=false
